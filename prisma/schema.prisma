generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model content_taxonomy {
  id          BigInt    @id @default(autoincrement())
  taxonomy    taxonomy? @relation(fields: [taxonomy_id], references: [id])
  taxonomy_id BigInt?
  post        post?     @relation(fields: [post_id], references: [id])
  post_id     BigInt?
}

model media {
  id         BigInt  @id @default(autoincrement())
  file_name  String
  file_path  String
  file_type  String
  size       Int
  content_id BigInt?
  post       post?   @relation(fields: [content_id], references: [id])
  user       users?  @relation(fields: [user_id], references: [id])
  user_id    String? @db.Uuid
}

model page {
  id          BigInt       @id @default(autoincrement())
  title       String?
  content     String?
  url         String?      @db.VarChar(50)
  description String       @db.VarChar(255)
  status      post_status? @default(draft)
}

model post {
  id               BigInt             @id @default(autoincrement())
  title            String
  content          String
  url              String?            @db.VarChar(255)
  description      String?            @db.VarChar(255)
  status           post_status?       @default(draft)
  featured         Boolean?           @default(false)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  author_id        String?            @db.Uuid
  content_taxonomy content_taxonomy[]
  media            media[]
  users            users?             @relation(fields: [author_id], references: [id])
}

model taxonomy {
  id               BigInt             @id @default(autoincrement())
  name             String
  slug             String             @unique
  description      String?
  type             taxonomy_type
  parent_id        BigInt?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  content_taxonomy content_taxonomy[]
}

model users {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(500)
  surname   String    @db.VarChar(500)
  email     String?   @unique @db.VarChar(500)
  password  String?   @db.VarChar(500)
  lastlogin DateTime? @default(now()) @db.Timestamptz(6)
  media     media[]
  post      post[]
}

enum post_status {
  draft
  published
  archived
}

enum taxonomy_type {
  category
  tag
}
