generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model post {
  id          Int            @id @default(autoincrement())
  title       String
  content     String
  url         String?        @db.VarChar(255) // per creare url custom
  description String?        @db.VarChar(255) // descrizione seo
  status      post_status?   @default(draft)
  featured    Boolean?       @default(false)
  created_at  DateTime?      @default(now()) @db.Timestamp(6)
  author_id   Int?
  users       users?         @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction) // Relazione con `users`
  taxonomies  postTaxonomy[]
  media       media[]
}

model taxonomy {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(255)
  description String? //descrizione opzionale
  type        taxonomy_type
  parent_id   Int? // utile per creare sotto categorie
  posts       postTaxonomy[]
}

model page {
  id          Int          @id @default(autoincrement())
  title       String?
  content     String?
  url         String?      @db.VarChar(255)
  description String       @db.VarChar(255)
  status      post_status? @default(draft)
}

model users {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(500)
  surname   String    @db.VarChar(500)
  email     String?   @unique @db.VarChar(500)
  password  String?   @db.VarChar(500)
  role      String
  lastlogin DateTime? @default(now()) @db.Timestamptz(6)
  post      post[]
  media     media[]
}

model media {
  id         Int       @id @default(autoincrement())
  user_id    Int? // Cambiato da String? a Int? per corrispondere al tipo di `id` in `users`
  file_name  String?   @db.VarChar(255)
  file_path  String?   @db.VarChar(255)
  file_type  String?   @db.VarChar(50)
  size       Int?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  content_id Int?
  post       post?     @relation(fields: [content_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_content_id_fk")
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_user_id_fk") // Relazione con `users`
}

model postTaxonomy {
  post_id     Int
  taxonomy_id Int

  post     post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  taxonomy taxonomy @relation(fields: [taxonomy_id], references: [id], onDelete: Cascade)

  @@id([post_id, taxonomy_id]) // chiave primaria composta
}

enum post_status {
  draft
  published
  archived
}

enum taxonomy_type {
  category
  tag
}
