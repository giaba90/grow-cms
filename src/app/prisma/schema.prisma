generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model content_taxonomy {
  id          Int       @id @default(autoincrement())
  content_id  Int?
  taxonomy_id Int?
  post        post?     @relation(fields: [content_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "content_taxonomy_content_id_fk")
  taxonomy    taxonomy? @relation(fields: [taxonomy_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "content_taxonomy_taxonomy_id_fk")
}

model media {
  id         Int       @id @default(autoincrement())
  user_id    Int? // Cambiato da String? a Int? per corrispondere al tipo di `id` in `users`
  file_name  String?   @db.VarChar(255)
  file_path  String?   @db.VarChar(255)
  file_type  String?   @db.VarChar(50)
  size       Int?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  content_id Int?
  post       post?     @relation(fields: [content_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_content_id_fk")
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_user_id_fk") // Relazione con `users`
}

model page {
  id          Int          @id @default(autoincrement())
  title       String?
  content     String?
  url         String?      @db.VarChar(255)
  description String       @db.VarChar(255)
  status      post_status? @default(draft)
}

model post {
  id               Int                @id @default(autoincrement())
  title            String
  content          String
  url              String?            @db.VarChar(255)
  description      String?            @db.VarChar(255)
  status           post_status?       @default(draft)
  featured         Boolean?           @default(false)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  author_id        Int? // Cambiato da String? a Int? per corrispondere al tipo di `id` in `users`
  content_taxonomy content_taxonomy[]
  media            media[]
  users            users?             @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction) // Relazione con `users`
}

model taxonomy {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(255)
  description      String?
  type             taxonomy_type
  parent_id        Int?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  content_taxonomy content_taxonomy[]
  taxonomy         taxonomy?          @relation("taxonomyTotaxonomy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_taxonomy   taxonomy[]         @relation("taxonomyTotaxonomy")
}

model users {
  id        Int       @id @default(autoincrement()) // ID cambiato da String a Int con autoincrement
  name      String    @db.VarChar(500)
  surname   String    @db.VarChar(500)
  email     String?   @unique @db.VarChar(500)
  password  String?   @db.VarChar(500) // Modificato per essere Stringa, non Bytes
  lastlogin DateTime? @default(now()) @db.Timestamptz(6)
  media     media[]
  post      post[]
  role      String
}

enum post_status {
  draft
  published
  archived
}

enum taxonomy_type {
  category
  tag
}
